import "./style.css";
import { session, redirect } from "@elements/app";
import { signout, Role } from "#app/shared/services/auth";
import favicon from "#app/shared/assets/favicons/favicon.svg";

interface NavLink {
  key: string;
  href: string;
  label: string;
}

const NAV: Record<Role, NavLink[]> = {
  manager: [
    { key: "dashboard", href: "/dashboard", label: "Dashboard" },
    { key: "board", href: "/board", label: "Board" },
    { key: "calendar", href: "/calendar", label: "Calendar" },
    { key: "assets", href: "/equipment", label: "Assets" },
    { key: "pm", href: "/pm", label: "Preventive" },
    { key: "parts", href: "/parts", label: "Parts" },
  ],
  technician: [
    { key: "today", href: "/today", label: "Today" },
    { key: "assets", href: "/equipment", label: "Assets" },
    { key: "parts", href: "/parts", label: "Parts" },
  ],
  requester: [
    { key: "requests", href: "/requests", label: "My requests" },
    { key: "new", href: "/work-orders/new", label: "Report a problem" },
  ],
};

function onSignout() {
  signout();
  redirect("/signin");
}

<Layout (
  title: string,
  active: string = "",
  shell: string = "",
)>
  <head>
    <title>{title} · Wrenchloft</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <header class="layout-header">
      <div class="layout-bar row">
        <a class="layout-brand row" href="/">
          <span class="layout-mark">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
          </span>
          Wrenchloft
        </a>

        <nav e:if={session.isLoggedIn()} class="layout-nav row" aria-label="Main">
          <a e:for={link of NAV[session.get("role") ?? "requester"]}
             href={link.href}
             class={[link.key === active && "is-active"]}>{link.label}</a>
        </nav>

        <div e:if={session.isLoggedIn()} class="layout-user row">
          <span class="layout-who">{session.get("userName")} · {session.get("role")}</span>
          <button class="is-ghost is-sm" onclick={() => onSignout()}>Sign out</button>
        </div>
      </div>
    </header>

    <main class={["layout-main page-shell", shell]}>
      <slot/>
    </main>
  </body>
</Layout>
